APP_DEBUG = true

DB_TYPE = mysql
DB_HOST = 127.0.0.1
DB_NAME = sistermart
DB_USER = sistermart
DB_PASS = sistermart
DB_PORT = 3306
DB_CHARSET = utf8mb4
DB_PREFIX =

DEFAULT_LANG = zh-cn

# 窄版發佈通道（預設關閉；上線前配置密鑰並設 true）
RELEASE_ENABLED = false
RELEASE_HMAC_SECRET =
# VPS 網站根（含 index.html / admin / sm-backend）。留空則：sm-backend 父目錄，或本地 runtime/release-site
RELEASE_SITE_ROOT =
RELEASE_MAX_BYTES = 83886080
RELEASE_LOCK_TTL = 900
RELEASE_ROLLBACK_FILES_ON_SQL_FAIL = true
# 路徑白名單：默認 false（只擋黑名單 + zip-slip）。設 true 則嚴格比對 manifest 白名單
RELEASE_ENFORCE_PATH_WHITELIST = false
