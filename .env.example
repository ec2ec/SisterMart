# SisterMart monorepo defaults (copy values into each app's env as needed)

# API (apps/api/.env) — ThinkPHP uses KEY = value spacing
# APP_DEBUG = true
# DB_TYPE = mysql
# DB_HOST = 127.0.0.1
# DB_NAME = sistermart
# DB_USER = sistermart
# DB_PASS = sistermart
# DB_PORT = 3306
# DB_CHARSET = utf8mb4

# Frontends
VITE_API_BASE=http://127.0.0.1:8000
VITE_APP_LOCALE=zh-HK

# Dev ports
API_PORT=8000
H5_PORT=5173
ADMIN_PORT=5174
